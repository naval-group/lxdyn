# export-ignore keeps these out of `git archive`, which makes GitHub's source archives
.gitattributes export-ignore
.gitignore export-ignore
# The last matching line wins, so the CRLF rules come after `*`
* text=auto eol=lf
*.sh        text eol=lf
*.[bB][aA][tT] text eol=crlf
# Checked out CRLF so the scenario parses a PRECAL_R file as Windows writes it
integration_tests/xdyn/issue_196_test.raodb.ini eol=crlf
