# A check is off for good only when it is wrong for this code; a deliberate site carries NOLINT(<check>): <reason>.
Checks:
  - '-*'
  - 'bugprone-*'
  - 'performance-*'
  - 'misc-throw-by-value-catch-by-reference'
  - 'modernize-make-shared'
  - 'modernize-make-unique'
  - 'modernize-use-override'
  - 'modernize-use-nullptr'
  - 'modernize-use-using'

  # Off for good.
  - '-bugprone-easily-swappable-parameters'  # an API-design opinion, and noisy
  - '-bugprone-switch-missing-default-case'  # a default: silences -Wswitch on a new enumerator
  - '-performance-avoid-endl'                # the flush is sometimes wanted, and the cost is noise
  - '-performance-enum-size'                 # bytes saved per enum, not a defect

  # Off until their sites are fixed, each by the commit that turns it on.
  - '-bugprone-branch-clone'
  - '-bugprone-derived-method-shadowing-base-method'
  - '-bugprone-empty-catch'
  - '-bugprone-exception-copy-constructor-throws'
  - '-bugprone-exception-escape'
  - '-bugprone-float-loop-counter'
  - '-bugprone-forward-declaration-namespace'
  - '-bugprone-narrowing-conversions'
  - '-bugprone-signed-char-misuse'
  - '-bugprone-suspicious-include'
  - '-bugprone-suspicious-string-compare'
  - '-bugprone-throwing-static-initialization'
  - '-bugprone-unchecked-string-to-number-conversion'
  - '-bugprone-unhandled-self-assignment'
  - '-bugprone-unused-local-non-trivial-variable'
  - '-bugprone-unused-raii'
  - '-performance-inefficient-string-concatenation'
  - '-performance-inefficient-vector-operation'
  - '-performance-noexcept-move-constructor'
  - '-performance-noexcept-swap'
  - '-performance-unnecessary-value-param'

WarningsAsErrors: '*'
# Third-party headers arrive through -isystem and stay quiet; these are the rest that are not ours.
HeaderFilterRegex: '.*'
ExcludeHeaderFilterRegex: '(/\.zig-cache/|/external/|/ssc/f2c/|/ssc/json/rapidjson/|/xdyn_wrapper_fmi/fmi2/)'
